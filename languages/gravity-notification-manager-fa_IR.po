msgstr "هشدار پیکربندی"

msgid "Configured"
msgstr "پیکربندی‌شده"

msgid "Configured for the normal Gravity Forms Feed lifecycle on submission."
msgstr "برای چرخه عادی Feed در Gravity Forms هنگام ثبت فرم پیکربندی شده است."

msgid "Configured in Gravity Flow Step “%s”."
msgstr "در مرحله Gravity Flow با نام «%s» پیکربندی شده است."

msgid "Create or enable a Gravity Notification Manager Feed in Gravity Forms. If dependencies are unavailable, check Help & Diagnostics."
msgstr "یک Feed مربوط به Gravity Notification Manager را در Gravity Forms بسازید یا فعال کنید. اگر وابستگی‌ها دردسترس نیستند، بخش راهنما و عیب‌یابی را بررسی کنید."

msgid "Detected Points"
msgstr "نقاط شناسایی‌شده"

msgid "Disabled"
msgstr "غیرفعال"

msgid "Enable the Feed in Gravity Forms when this notification should run."
msgstr "اگر این اعلان باید اجرا شود، Feed را در Gravity Forms فعال کنید."

msgid "Enter a valid Bale numeric chat ID or @channel username."
msgstr "یک شناسه عددی چت بله یا نام کاربری کانال با @ وارد کنید."

msgid "Enter a valid E.164 SMS destination."
msgstr "یک مقصد SMS معتبر با قالب E.164 وارد کنید."

msgid "Entry field"
msgstr "فیلد Entry"

msgid "Environment"
msgstr "محیط"

msgid "Fallback"
msgstr "مسیر جایگزین"

msgid "Fallback Policy"
msgstr "سیاست مسیر جایگزین"

msgid "Feed"
msgstr "Feed"

msgid "Feed %d"
msgstr "Feed %d"

msgid "Feed configuration is incomplete: %s."
msgstr "پیکربندی Feed کامل نیست: %s."

msgid "Feed Name"
msgstr "نام Feed"

msgid "Feed/Flow"
msgstr "Feed / Flow"

msgid "Final state"
msgstr "وضعیت نهایی"

msgid "Fixed target"
msgstr "مقصد ثابت"

msgid "Form %d"
msgstr "فرم %d"

msgid "GNM Feed Step"
msgstr "مرحله Feed افزونه GNM"

msgid "Gravity Flow"
msgstr "Gravity Flow"

msgid "Gravity Flow assignee"
msgstr "مسئول Gravity Flow"

msgid "Gravity Flow is unavailable, so workflow placement cannot be verified."
msgstr "Gravity Flow دردسترس نیست؛ بنابراین محل قرارگیری در گردش‌کار قابل بررسی نیست."

msgid "Gravity Forms"
msgstr "Gravity Forms"

msgid "Gravity Notification Manager"
msgstr "Gravity Notification Manager"

msgid "Gravity Notification Manager provider test message."
msgstr "پیام آزمایشی ارائه‌دهنده Gravity Notification Manager."

msgid "Gravity Notification Manager Retry"
msgstr "تلاش مجدد Gravity Notification Manager"

msgid "Gravity Notification Manager: Composer autoloader not found. Please run `composer install` in the plugin directory."
msgstr "Gravity Notification Manager: بارگذار Composer پیدا نشد. لطفاً دستور `composer install` را در پوشه افزونه اجرا کنید."

msgid "GravityView"
msgstr "GravityView"

msgid "Help & Diagnostics"
msgstr "راهنما و عیب‌یابی"

msgid "Invalid Notification Point identifiers."
msgstr "شناسه‌های نقطه اعلان نامعتبر هستند."

msgid "IPPanel"
msgstr "IPPanel"

msgid "IPPanel / SMS test"
msgstr "آزمون IPPanel / SMS"

msgid "IPPanel API key"
msgstr "کلید API آی‌پی‌پنل"

msgid "IPPanel test could not run because the API key or sender number is not configured."
msgstr "آزمون IPPanel قابل اجرا نبود زیرا کلید API یا شماره فرستنده پیکربندی نشده است."

msgid "Last execution:"
msgstr "آخرین اجرا:"

msgid "Message"
msgstr "پیام"

msgid "Native multi-channel notifications for Gravity Forms and Gravity Flow."
msgstr "اعلان‌های بومی چندکاناله برای Gravity Forms و Gravity Flow."

msgid "Native WordPress settings for approved greenfield provider configuration. Saving does not send messages or migrate legacy values."
msgstr "تنظیمات بومی وردپرس برای پیکربندی تأییدشده ارائه‌دهندگان جدید. ذخیره‌سازی هیچ پیامی ارسال نمی‌کند و مقادیر قدیمی را مهاجرت نمی‌دهد."

msgid "Needs Setup"
msgstr "نیازمند تنظیم"

msgid "Next action:"
msgstr "اقدام بعدی:"

msgid "No"
msgstr "خیر"

msgid "No fallback"
msgstr "بدون مسیر جایگزین"

msgid "No notification delivery state has been recorded for this Entry yet."
msgstr "هنوز هیچ وضعیت تحویل اعلانی برای این Entry ثبت نشده است."

msgid "No notification Feeds detected"
msgstr "هیچ Feed اعلانی شناسایی نشد"

msgid "No provider attempt was recorded for the last execution."
msgstr "برای آخرین اجرا هیچ تلاش ارائه‌دهنده‌ای ثبت نشده است."

msgid "No topology change is required. Use Check Again after workflow edits."
msgstr "تغییری در ساختار لازم نیست. پس از ویرایش گردش‌کار، «بررسی دوباره» را اجرا کنید."

msgid "No workflow Step is required unless this notification must run at a workflow position."
msgstr "تا زمانی که این اعلان نباید در محل مشخصی از گردش‌کار اجرا شود، مرحله گردش‌کار لازم نیست."

msgid "Not Applicable"
msgstr "قابل اعمال نیست"

msgid "Not configured"
msgstr "پیکربندی نشده"

msgid "Not detected"
msgstr "شناسایی نشد"

msgid "Notification Delivery"
msgstr "تحویل اعلان"

msgid "Notification delivery state is unavailable for this Entry."
msgstr "وضعیت تحویل اعلان برای این Entry دردسترس نیست."

msgid "Notification Manager"
msgstr "مدیریت اعلان‌ها"

msgid "Notification Point was not found."
msgstr "نقطه اعلان پیدا نشد."

msgid "Notification Points"
msgstr "نقاط اعلان"

msgid "Notification Rule"
msgstr "قانون اعلان"

msgid "Notification state is malformed or untrusted; it is not treated as resolved."
msgstr "وضعیت اعلان نامعتبر یا غیرقابل‌اعتماد است و حل‌شده در نظر گرفته نمی‌شود."

msgid "One or more Notification Points need operator setup. GNM will not repair workflow topology automatically."
msgstr "یک یا چند نقطه اعلان به تنظیم اپراتور نیاز دارند. GNM ساختار گردش‌کار را به‌صورت خودکار تغییر یا تعمیر نمی‌کند."

msgid "Open Forms → %s → Settings → Workflow and activate this Step or correct the intended placement, then use Check Again. GNM will not activate or change Steps automatically."
msgstr "در Forms، فرم «%s» را باز کنید و به Settings → Workflow بروید. این مرحله را فعال یا محل موردنظر را اصلاح کنید، سپس «بررسی دوباره» را بزنید. GNM مراحل را خودکار فعال یا تغییر نمی‌دهد."

msgid "Open Forms → %s → Settings → Workflow and keep this Feed selected only at the intended notification position. GNM will not change Steps automatically."
msgstr "در Forms، فرم «%s» را باز کنید و به Settings → Workflow بروید. این Feed را فقط در محل موردنظر اعلان انتخاب‌شده نگه دارید. GNM مراحل را به‌صورت خودکار تغییر نمی‌دهد."

msgid "Open Forms → %s → Settings → Workflow. Add a Gravity Notification Manager Feed Step at the intended position, select this Feed, and save. GNM will not insert or reorder Steps."
msgstr "در Forms، فرم «%s» را باز کنید و به Settings → Workflow بروید. در محل موردنظر یک Gravity Notification Manager Feed Step اضافه کنید، این Feed را انتخاب و ذخیره کنید. GNM مرحله‌ای را خودکار اضافه یا جابه‌جا نمی‌کند."

msgid "Open Gravity Flow"
msgstr "باز کردن Gravity Flow"

msgid "Open Gravity Forms Entry Detail"
msgstr "باز کردن جزئیات Entry در Gravity Forms"

msgid "Open this Gravity Forms notification Feed and complete the listed settings, then save it."
msgstr "این Feed اعلانی را در Gravity Forms باز کنید، تنظیمات فهرست‌شده را کامل کنید و سپس ذخیره کنید."

msgid "Operational configuration health from current Feed and Flow truth."
msgstr "وضعیت سلامت پیکربندی بر اساس داده واقعی فعلی Feed و Flow."

msgid "Overview"
msgstr "نمای کلی"

msgid "Persisted notification state is malformed or untrusted. It is not treated as resolved, and Retry is unavailable until valid state exists."
msgstr "وضعیت ذخیره‌شده اعلان نامعتبر یا غیرقابل‌اعتماد است. این وضعیت حل‌شده در نظر گرفته نمی‌شود و تا ایجاد وضعیت معتبر، تلاش مجدد دردسترس نیست."

msgid "PHP"
msgstr "PHP"

msgid "Point checks"
msgstr "بررسی نقاط"

msgid "Privacy-safe, side-effect-free facts. No provider request is made by this screen."
msgstr "اطلاعات این صفحه بدون افشای داده خصوصی و بدون اثر جانبی است. از این صفحه هیچ درخواستی به ارائه‌دهنده ارسال نمی‌شود."

msgid "Provider acceptance could not be established safely."
msgstr "پذیرش پیام توسط ارائه‌دهنده به‌صورت امن قابل اثبات نبود."

msgid "Provider configuration"
msgstr "پیکربندی ارائه‌دهندگان"

msgid "Provider reference:"
msgstr "شناسه مرجع ارائه‌دهنده:"

msgid "Read-only guidance and verification. Gravity Flow remains the workflow topology authority."
msgstr "راهنمایی و بررسی فقط‌خواندنی است. Gravity Flow همچنان مرجع ساختار گردش‌کار است."

msgid "Real external send:"
msgstr "ارسال واقعی خارجی:"

msgid "Recipient Source"
msgstr "منبع گیرنده"

msgid "Recipient Source Value"
msgstr "مقدار منبع گیرنده"

msgid "Resolve missing dependencies first, then review Notification Points for exact workflow guidance. Diagnostics never include credentials, recipients, Entry contents, or raw provider responses."
msgstr "ابتدا وابستگی‌های مفقود را برطرف کنید، سپس برای راهنمای دقیق گردش‌کار نقاط اعلان را بررسی کنید. عیب‌یابی هرگز شامل اطلاعات محرمانه، گیرندگان، محتوای Entry یا پاسخ خام ارائه‌دهنده نیست."

msgid "Result: %s"
msgstr "نتیجه: %s"

msgid "Retry completed and authoritative Entry Meta now confirms"
msgstr "تلاش مجدد انجام شد و Entry Meta معتبر اکنون این وضعیت را تأیید می‌کند:"

msgid "Retry completed successfully."
msgstr "تلاش مجدد با موفقیت انجام شد."

msgid "Retry completed without confirmed resolution. Attention Required remains active."
msgstr "تلاش مجدد انجام شد، اما حل‌شدن تأیید نشد. وضعیت «نیازمند رسیدگی» همچنان فعال است."

msgid "Retry completed, but delivery resolution is not confirmed."
msgstr "تلاش مجدد انجام شد، اما نتیجه نهایی تحویل تأیید نشده است."

msgid "Retry eligibility"
msgstr "امکان تلاش مجدد"

msgid "Retry is synchronous and may contact the configured external channel."
msgstr "تلاش مجدد همگام است و ممکن است با کانال خارجی پیکربندی‌شده ارتباط برقرار کند."

msgid "Retry notification now"
msgstr "اکنون اعلان را دوباره ارسال کن"

msgid "Retry requires a POST request."
msgstr "تلاش مجدد به درخواست POST نیاز دارد."

msgid "Retry result could not be confirmed from current authoritative Entry Meta."
msgstr "نتیجه تلاش مجدد از Entry Meta معتبر فعلی قابل تأیید نبود."

msgid "Retry transport may have run, but a persisted state transition was not confirmed. Do not infer delivery resolution."
msgstr "ممکن است انتقال تلاش مجدد اجرا شده باشد، اما تغییر وضعیت ذخیره‌شده تأیید نشده است. حل‌شدن تحویل را نتیجه‌گیری نکنید."

msgid "Review Notification Points"
msgstr "بررسی نقاط اعلان"

msgid "Safe next actions"
msgstr "اقدام‌های بعدی امن"

msgid "Save Settings"
msgstr "ذخیره تنظیمات"

msgid "Saving settings does not send messages. Provider tests below send only when you explicitly submit a test action."
msgstr "ذخیره تنظیمات پیامی ارسال نمی‌کند. آزمون‌های ارائه‌دهنده در ادامه فقط زمانی پیام می‌فرستند که شما صراحتاً اقدام آزمایشی را ارسال کنید."

msgid "Send Test Bale Message"
msgstr "ارسال پیام آزمایشی بله"

msgid "Send Test SMS"
msgstr "ارسال SMS آزمایشی"

msgid "Settings"
msgstr "تنظیمات"

msgid "SMS"
msgstr "SMS"

msgid "SMS Providers"
msgstr "ارائه‌دهندگان SMS"

msgid "SMS Providers / IPPanel"
msgstr "ارائه‌دهندگان SMS / IPPanel"

msgid "SMS sender number (E.164)"
msgstr "شماره فرستنده SMS (E.164)"

msgid "State is malformed or untrusted."
msgstr "وضعیت نامعتبر یا غیرقابل‌اعتماد است."

msgid "State is malformed or untrusted. Attention Required; Retry unavailable."
msgstr "وضعیت نامعتبر یا غیرقابل‌اعتماد است. نیازمند رسیدگی است و تلاش مجدد دردسترس نیست."

msgid "Stored credentials are never echoed back into this page or diagnostics."
msgstr "اطلاعات محرمانه ذخیره‌شده هرگز در این صفحه یا بخش عیب‌یابی نمایش داده نمی‌شوند."

msgid "Stored — Enter a new value to replace"
msgstr "ذخیره شده — برای جایگزینی، مقدار جدید وارد کنید"

msgid "Submitting this action sends one real Bale message through the configured bot."
msgstr "با ارسال این اقدام، یک پیام واقعی بله از طریق ربات پیکربندی‌شده ارسال می‌شود."

msgid "Submitting this action sends one real SMS through the configured IPPanel account."
msgstr "با ارسال این اقدام، یک SMS واقعی از طریق حساب IPPanel پیکربندی‌شده ارسال می‌شود."

msgid "Test Bale chat destination"
msgstr "مقصد چت آزمایشی بله"

msgid "Test SMS destination (E.164)"
msgstr "مقصد SMS آزمایشی (E.164)"

msgid "The Entry ID is invalid."
msgstr "شناسه Entry نامعتبر است."

msgid "The Feed ID is invalid."
msgstr "شناسه Feed نامعتبر است."

msgid "The matching Gravity Flow Step “%s” is inactive."
msgstr "مرحله متناظر Gravity Flow با نام «%s» غیرفعال است."

msgid "The provider accepted the test message."
msgstr "ارائه‌دهنده پیام آزمایشی را پذیرفت."

msgid "The provider rejected the test request."
msgstr "ارائه‌دهنده درخواست آزمایشی را رد کرد."

msgid "The provider test did not produce a recognized safe result."
msgstr "آزمون ارائه‌دهنده نتیجه امن و شناخته‌شده‌ای تولید نکرد."

msgid "The requested Gravity Forms Entry could not be found."
msgstr "Entry درخواستی Gravity Forms پیدا نشد."

msgid "The requested notification Feed is invalid or unavailable."
msgstr "Feed اعلانی درخواستی نامعتبر است یا دردسترس نیست."

msgid "The Retry request could not be completed."
msgstr "درخواست تلاش مجدد کامل نشد."

msgid "The Retry request could not be verified. Reload the page and try again."
msgstr "درخواست تلاش مجدد قابل تأیید نبود. صفحه را دوباره بارگذاری کنید و مجدداً تلاش کنید."

msgid "The test request could not be created safely."
msgstr "درخواست آزمایشی به‌صورت امن قابل ساخت نبود."

msgid "This Feed is selected by multiple GNM workflow Steps."
msgstr "این Feed توسط چند مرحله گردش‌کار GNM انتخاب شده است."

msgid "This Feed needs Gravity Flow assignee context but is not selected by a GNM workflow Step."
msgstr "این Feed به زمینه مسئول Gravity Flow نیاز دارد، اما توسط هیچ مرحله گردش‌کار GNM انتخاب نشده است."

msgid "This notification Feed is disabled."
msgstr "این Feed اعلانی غیرفعال است."

msgid "This notification is not currently eligible for Retry, or its updated state could not be confirmed."
msgstr "این اعلان در حال حاضر واجد شرایط تلاش مجدد نیست یا وضعیت به‌روزشده آن قابل تأیید نیست."

msgid "Unavailable"
msgstr "دردسترس نیست"

msgid "Unavailable / Disabled"
msgstr "دردسترس نیست / غیرفعال"

msgid "Unnamed notification Feed"
msgstr "Feed اعلانی بدون نام"

msgid "WordPress"
msgstr "وردپرس"

msgid "WordPress role"
msgstr "نقش وردپرس"

msgid "WordPress user"
msgstr "کاربر وردپرس"

msgid "Yes"
msgstr "بله"

msgid "You are not allowed to manage Gravity Notification Manager."
msgstr "شما اجازه مدیریت Gravity Notification Manager را ندارید."

msgid "You are not allowed to retry this notification."
msgstr "شما اجازه تلاش مجدد برای این اعلان را ندارید."

msgid "Advisor"
msgstr "مشاور"

msgid "Task-oriented guidance from current GNM configuration. Advisor reads existing state only; it does not send, retry, save settings, or change Gravity Flow topology."
msgstr "راهنمای وظیفه‌محور بر پایه پیکربندی فعلی GNM. مشاور فقط وضعیت موجود را می‌خواند؛ پیام ارسال نمی‌کند، تلاش مجدد انجام نمی‌دهد، تنظیمات را ذخیره نمی‌کند و ساختار Gravity Flow را تغییر نمی‌دهد."

msgid "Current detail:"
msgstr "جزئیات فعلی:"

msgid "How do I configure a provider?"
msgstr "چطور یک ارائه‌دهنده را پیکربندی کنم؟"

msgid "Open Settings"
msgstr "باز کردن تنظیمات"

msgid "How do I test SMS or Bale?"
msgstr "چطور SMS یا بله را آزمایش کنم؟"

msgid "Open Settings and use the dedicated IPPanel / SMS or Bale test control. Saving normal settings never sends a message; each test control is a separate explicit action that performs one real external send."
msgstr "تنظیمات را باز کنید و از کنترل اختصاصی آزمون IPPanel / SMS یا بله استفاده کنید. ذخیره معمولی تنظیمات هرگز پیامی ارسال نمی‌کند؛ هر کنترل آزمون یک اقدام صریح و جداگانه است که یک ارسال واقعی خارجی انجام می‌دهد."

msgid "Open provider tests"
msgstr "باز کردن آزمون‌های ارائه‌دهنده"

msgid "How do I create a notification?"
msgstr "چطور یک اعلان بسازم؟"

msgid "Open Help & Diagnostics"
msgstr "باز کردن راهنما و عیب‌یابی"

msgid "Where do I place it in Gravity Flow?"
msgstr "آن را کجای Gravity Flow قرار دهم؟"

msgid "How do I verify Notification Points?"
msgstr "چطور نقاط اعلان را بررسی کنم؟"

msgid "Open Notification Points to inspect the current Feed and Gravity Flow placement truth. Use Check Again after changing a Feed or workflow Step; GNM only re-reads configuration and never repairs topology automatically."
msgstr "نقاط اعلان را باز کنید تا وضعیت واقعی فعلی Feed و محل قرارگیری در Gravity Flow را بررسی کنید. پس از تغییر Feed یا مرحله گردش‌کار، «بررسی دوباره» را اجرا کنید؛ GNM فقط پیکربندی را دوباره می‌خواند و هرگز ساختار را خودکار تعمیر نمی‌کند."

msgid "Open Notification Points"
msgstr "باز کردن نقاط اعلان"

msgid "Why does this point say NEEDS_SETUP?"
msgstr "چرا این نقطه وضعیت NEEDS_SETUP دارد؟"

msgid "No current Notification Point is marked NEEDS_SETUP. If that changes, Advisor will repeat the same detail and next action reported by Notification Points."
msgstr "در حال حاضر هیچ نقطه اعلانی با وضعیت NEEDS_SETUP علامت‌گذاری نشده است. اگر این وضعیت تغییر کند، مشاور همان جزئیات و اقدام بعدی گزارش‌شده در نقاط اعلان را نمایش می‌دهد."

msgid "These Notification Points currently need setup. The detail and next action below come directly from the existing Point Inspector truth."
msgstr "این نقاط اعلان در حال حاضر نیازمند تنظیم هستند. جزئیات و اقدام بعدی زیر مستقیماً از وضعیت واقعی Point Inspector موجود می‌آیند."

msgid "How do I Retry a failed notification?"
msgstr "چطور یک اعلان ناموفق را دوباره تلاش کنم؟"

msgid "Open the affected Gravity Forms Entry Detail and find the Notification Delivery box. Retry appears there only when the stored target is trusted, Attention Required is true, Retry is currently allowed, and your account has the required capability. Retry is an explicit synchronous action and may contact the configured external channel."
msgstr "جزئیات Entry مربوطه را در Gravity Forms باز کنید و کادر «تحویل اعلان» را پیدا کنید. گزینه تلاش مجدد فقط زمانی نمایش داده می‌شود که مقصد ذخیره‌شده قابل‌اعتماد باشد، وضعیت «نیازمند رسیدگی» فعال باشد، تلاش مجدد در حال حاضر مجاز باشد و حساب شما دسترسی لازم را داشته باشد. تلاش مجدد یک اقدام صریح و همگام است و ممکن است با کانال خارجی پیکربندی‌شده ارتباط برقرار کند."

msgid "Where do I see Attention Required?"
msgstr "وضعیت «نیازمند رسیدگی» را کجا ببینم؟"

msgid "IPPanel and Bale are currently configured according to Settings readiness. Use Settings to review the SMS sender or replace stored credentials."
msgstr "بر اساس وضعیت آمادگی تنظیمات، IPPanel و بله هر دو اکنون پیکربندی شده‌اند. برای بررسی شماره فرستنده SMS یا جایگزینی اطلاعات محرمانه ذخیره‌شده، تنظیمات را باز کنید."

msgid "IPPanel and Bale both need setup. Configure the IPPanel API key plus a valid E.164 sender number, and configure the Bale bot token in Settings."
msgstr "IPPanel و بله هر دو نیازمند تنظیم هستند. در تنظیمات، کلید API آی‌پی‌پنل همراه با یک شماره فرستنده معتبر E.164 و همچنین توکن ربات بله را پیکربندی کنید."

msgid "IPPanel needs setup: configure the API key and a valid E.164 sender number in Settings. Bale is currently configured."
msgstr "IPPanel نیازمند تنظیم است: کلید API و یک شماره فرستنده معتبر E.164 را در تنظیمات وارد کنید. بله در حال حاضر پیکربندی شده است."

msgid "Bale needs setup: configure the bot token in Settings. IPPanel is currently configured."
msgstr "بله نیازمند تنظیم است: توکن ربات را در تنظیمات وارد کنید. IPPanel در حال حاضر پیکربندی شده است."

msgid "Gravity Forms is not currently available, so a GNM Notification Feed cannot be configured yet. Resolve the dependency first in Help & Diagnostics."
msgstr "Gravity Forms در حال حاضر دردسترس نیست، بنابراین هنوز نمی‌توان یک Feed اعلان GNM را پیکربندی کرد. ابتدا وابستگی را در بخش راهنما و عیب‌یابی برطرف کنید."

msgid "No GNM Notification Feed is currently detected. In Gravity Forms, open the intended Form, open Settings → Gravity Notification Manager, create a Feed, complete its message, channel, recipient source and fallback settings, then enable and save it."
msgstr "در حال حاضر هیچ Feed اعلان GNM شناسایی نشده است. در Gravity Forms فرم موردنظر را باز کنید، به Settings → Gravity Notification Manager بروید، یک Feed بسازید، پیام، کانال، منبع گیرنده و تنظیمات مسیر جایگزین آن را کامل کنید، سپس آن را فعال و ذخیره کنید."

msgid "GNM already detects one or more Notification Feeds. Create or edit each logical notification in Gravity Forms under the Form’s Gravity Notification Manager Feed settings; Notification Points will verify the saved result."
msgstr "GNM از قبل یک یا چند Feed اعلان را شناسایی کرده است. هر اعلان منطقی را در تنظیمات Feed مربوط به Gravity Notification Manager برای همان فرم در Gravity Forms بسازید یا ویرایش کنید؛ نقاط اعلان نتیجه ذخیره‌شده را بررسی می‌کند."

msgid "Gravity Flow is not currently available, so Advisor will not invent a workflow link. Resolve the dependency in Help & Diagnostics, then verify placement from Notification Points."
msgstr "Gravity Flow در حال حاضر دردسترس نیست، بنابراین مشاور لینک ساختگی برای گردش‌کار ایجاد نمی‌کند. وابستگی را در راهنما و عیب‌یابی برطرف کنید و سپس محل قرارگیری را از نقاط اعلان بررسی کنید."

msgid "Create the GNM Notification Feed first. When the notification must run at a workflow position, open the Form’s Workflow settings, add the supported Gravity Notification Manager Feed Step at the intended position, select the Feed and save."
msgstr "ابتدا Feed اعلان GNM را بسازید. اگر اعلان باید در موقعیت مشخصی از گردش‌کار اجرا شود، تنظیمات Workflow فرم را باز کنید، مرحله پشتیبانی‌شده Gravity Notification Manager Feed را در محل موردنظر اضافه کنید، Feed را انتخاب و ذخیره کنید."

msgid "When a notification must run at a workflow position, use the Form’s Workflow settings and the supported Gravity Notification Manager Feed Step. The known Form links below reuse GNM’s existing Gravity Flow navigation helper."
msgstr "اگر اعلان باید در موقعیت مشخصی از گردش‌کار اجرا شود، از تنظیمات Workflow فرم و مرحله پشتیبانی‌شده Gravity Notification Manager Feed استفاده کنید. لینک‌های شناخته‌شده فرم در ادامه از همان راهنمای ناوبری موجود Gravity Flow در GNM استفاده می‌کنند."

msgid "Central Attention Required cases remain in the site-configured GravityView / Elementor presentation. Advisor does not know or invent a specific View URL. Gravity Forms Entry Detail remains the independent status and Retry fallback for an individual Entry."
msgstr "موارد مرکزی «نیازمند رسیدگی» همچنان در نمایش GravityView / Elementor پیکربندی‌شده سایت قرار دارند. مشاور آدرس مشخص یک View را نمی‌داند و آن را اختراع نمی‌کند. جزئیات Entry در Gravity Forms همچنان مسیر مستقل مشاهده وضعیت و تلاش مجدد برای یک Entry است."

msgid "GravityView is not currently detected. Advisor does not create a replacement case dashboard; use Gravity Forms Entry Detail as the independent status and Retry fallback until the site’s GravityView / Elementor Attention Required presentation is available."
msgstr "GravityView در حال حاضر شناسایی نشده است. مشاور داشبورد جایگزین برای پرونده‌ها نمی‌سازد؛ تا زمانی که نمایش «نیازمند رسیدگی» سایت در GravityView / Elementor دردسترس شود، از جزئیات Entry در Gravity Forms به‌عنوان مسیر مستقل وضعیت و تلاش مجدد استفاده کنید."

msgid "Operational Log"
msgstr "گزارش عملیاتی"

msgid "Observational evidence for outbound attempts. Gravity Forms Entry Meta remains delivery-state and Retry authority."
msgstr "شواهد مشاهده‌ای تلاش‌های خروجی. Entry Meta در Gravity Forms همچنان مرجع وضعیت تحویل و تلاش مجدد است."

